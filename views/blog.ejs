<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { seo }) %>
</head>
<body>
  <%- include('partials/header') %>

  <main>

    <!-- ===== HEADER ===== -->
    <section class="blog-hero">
      <div class="blog-hero-inner">
        <h1 class="blog-hero-title">Blog</h1>
        <p class="blog-hero-sub">Insights, tips, and updates from the Bhojan Mitra team</p>
      </div>
    </section>

    <!-- ===== POSTS GRID ===== -->
    <section class="blog-section">
      <div class="blog-inner">

        <% const featured = posts[0]; const rest = posts.slice(1); %>
        <!-- Featured post -->
        <a href="/blog/<%= featured.slug %>" class="blog-card blog-card--featured">
          <div class="blog-card-img blog-card-img--<%= featured.color %>">
            <div class="blog-card-img-text"><%= featured.title %></div>
          </div>
          <div class="blog-card-body">
            <span class="blog-tag"><%= featured.tag %></span>
            <h2 class="blog-card-title"><%= featured.title %></h2>
            <% if (featured.excerpt) { %><p class="blog-card-excerpt"><%= featured.excerpt %></p><% } %>
            <span class="blog-card-date"><%= featured.date %></span>
          </div>
        </a>

        <!-- Posts grid -->
        <div class="blog-grid">
          <% rest.forEach(function(p) { %>
          <a href="/blog/<%= p.slug %>" class="blog-card">
            <div class="blog-card-img blog-card-img--<%= p.color %>">
              <div class="blog-card-img-text"><%= p.title %></div>
            </div>
            <div class="blog-card-body">
              <span class="blog-tag"><%= p.tag %></span>
              <h3 class="blog-card-title"><%= p.title %></h3>
              <span class="blog-card-date"><%= p.date %></span>
            </div>
          </a>
          <% }); %>
        </div>
      </div>
    </section>

    <!-- ===== CTA ===== -->
    <section class="blog-cta">
      <div class="blog-cta-inner">
        <h2 class="blog-cta-title">Ready to scale your restaurant with<br>AI-powered operations?</h2>
        <a href="/contact" class="bm-btn-primary">Talk to us</a>
      </div>
    </section>

  </main>

  <%- include('partials/footer') %>
  <script src="/js/main.js?v=<%= locals.assetVersion %>"></script>
</body>
</html>
