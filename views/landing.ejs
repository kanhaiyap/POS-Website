<!DOCTYPE html>
<html lang="<%= page.lang || 'en' %>">
<head>
  <%- include('partials/head', { seo }) %>
</head>
<body>
  <%- include('partials/header') %>

  <main>

    <!-- ===== HERO ===== -->
    <section class="bm-hero">
      <div class="bm-hero-inner">
        <nav class="lp-breadcrumb" aria-label="Breadcrumb">
          <a href="/"><%= t.home %></a> <span aria-hidden="true">/</span>
          <a href="/solutions"><%= t.solutions %></a> <span aria-hidden="true">/</span>
          <span><%= page.navLabel %></span>
          <% if (langSwitch) { %> · <a href="<%= langSwitch.href %>" class="lp-lang-switch" hreflang="<%= page.lang === 'hi' ? 'en' : 'hi' %>"><%= langSwitch.label %></a><% } %>
        </nav>
        <h1 class="bm-hero-title"><%= page.h1 %></h1>
        <p class="bm-hero-subtitle"><%= page.intro %></p>
        <div class="lp-hero-actions">
          <a href="/contact" class="bm-btn-primary"><%= t.demo %></a>
          <a href="/pricing" class="lp-btn-ghost"><%= t.pricing %></a>
        </div>
      </div>
    </section>

    <!-- ===== FEATURES ===== -->
    <section class="bm-features">
      <div class="bm-features-inner">
        <div class="bm-badge"><%= page.badge %></div>
        <div class="rpos-feature-list">
          <% page.sections.forEach(function(s) { %>
          <div class="rpos-feature">
            <h2 class="rpos-feature-title"><%= s.h2 %></h2>
            <p class="rpos-feature-desc"><%= s.p %></p>
          </div>
          <% }); %>
        </div>

        <% if (page.areas && page.areas.length) { %>
        <h2 class="lp-subheading"><%= page.areasHeading || t.areas %></h2>
        <ul class="lp-chips">
          <% page.areas.forEach(function(a) { %><li><%= a %></li><% }); %>
        </ul>
        <% } %>

        <% if (page.useCases && page.useCases.length) { %>
        <h2 class="lp-subheading"><%= t.whoUses %></h2>
        <ul class="lp-chips">
          <% page.useCases.forEach(function(u) { %><li><%= u %></li><% }); %>
        </ul>
        <% } %>
      </div>
    </section>

    <%- include('partials/google-reviews') %>

    <!-- ===== PRICING STRIP ===== -->
    <section class="lp-pricing">
      <div class="lp-pricing-inner">
        <h2 class="lp-subheading"><%= t.pricingHeading %></h2>
        <div class="lp-price-row">
          <div class="lp-price lp-price--free"><span class="lp-price-amt">₹0</span><span class="lp-price-name"><%= t.planFree %></span></div>
          <div class="lp-price"><span class="lp-price-amt">₹250</span><span class="lp-price-name"><%= t.planBilling %></span></div>
          <div class="lp-price"><span class="lp-price-amt">₹500</span><span class="lp-price-name"><%= t.planAnalytics %></span></div>
          <div class="lp-price"><span class="lp-price-amt">₹5,000</span><span class="lp-price-name"><%= t.planVoice %></span></div>
        </div>
        <a href="/pricing" class="lp-link"><%= t.compare %></a>
      </div>
    </section>

    <!-- ===== FAQ ===== -->
    <section class="bm-faq">
      <div class="bm-faq-inner">
        <p class="bm-faq-eyebrow">FAQ</p>
        <h2 class="bm-faq-title"><%= t.faqPrefix %> <span class="bm-faq-muted"><%= page.navLabel %></span></h2>
        <div class="bm-faq-list">
          <% page.faqs.forEach(function(f) { %>
          <details class="bm-faq-item">
            <summary class="bm-faq-question">
              <%= f.q %>
              <span class="bm-faq-icon"></span>
            </summary>
            <p class="bm-faq-answer"><%= f.a %></p>
          </details>
          <% }); %>
        </div>
      </div>
    </section>

    <!-- ===== RELATED ===== -->
    <% if (related.length) { %>
    <section class="lp-related">
      <div class="lp-related-inner">
        <h2 class="lp-subheading"><%= t.related %></h2>
        <ul class="lp-related-grid">
          <% related.forEach(function(r) { %>
          <li><a href="/<%= r.slug %>" class="lp-related-card"><%= r.navLabel %> <span aria-hidden="true">→</span></a></li>
          <% }); %>
        </ul>
      </div>
    </section>
    <% } %>

    <!-- ===== CTA ===== -->
    <section class="rpos-cta">
      <div class="rpos-cta-inner">
        <h2 class="rpos-cta-title"><%= t.ctaTitle %></h2>
        <p class="rpos-cta-sub"><%= t.ctaSub %></p>
        <a href="/contact" class="bm-btn-primary"><%= t.demo %></a>
        <p class="lp-local-note"><%- t.localNote %></p>
      </div>
    </section>

  </main>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
